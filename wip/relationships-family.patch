+    const pa = getPartner(p);
+    if (pa && pa.partnerStatus === "dating" && pa.relationshipBar > 50) settle(propose(p, rng));
+    if (pa && pa.partnerStatus === "married" && p.age < 38) settle(tryForBaby(p, rng));
+    const res = ageUp(p, rng);
+    p = res.player;
+    for (const n of (res.notices ?? []) as Notice[]) if (n.kind === "event" && p.alive) settle(resolveEvent(p, n.event, 0, rng));
+    if (p.age >= Number(process.env.SAVE_AGE ?? 44)) break;
