+  p.bankBalance = 200000;
+  fs.writeFileSync(process.env.SAVE_OUT ?? "/tmp/claude-0/-home-user-bitlife-clone/9286e593-ea74-5b82-bd58-1dff269f48ec/scratchpad/save1.json", exportSave(p, rng.state()));
+  console.log(p.age, p.relatives.map((r) => `${r.relation}:${r.name}:${r.age}:${r.partnerStatus ?? ""}`).join(" | "));
+});
