+    case "mono":
+    case "divorcee":
+    case "parent": {
+      if (p.age >= 18 && !pa && rng.chance(0.35)) p = take(meetSomeone(p, "date", rng) as never);
+      if (pa && pa.partnerStatus === "dating" && pa.relationshipBar > 55 && rng.chance(0.4)) p = settle(p, propose(p, rng));
