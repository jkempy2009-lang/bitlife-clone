+
+/** Shared by the action and the crisis event. */
+function runCounselling(p: PlayerState, rel: Relative, rng: Rng): ActionResult["notices"] {
+  const n = first(rel);
+  p.annual[`counsel:${rel.id}`] = 1;
+  p.bankBalance -= COUNSELLING_COST;
