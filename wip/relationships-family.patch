+
+describe("scratch play", () => {
+  it("plays lives", () => {
+    const log: string[] = [];
+    const stats: Record<string, { lives: number; married: number; divorced: number; kids: number; affairs: number; avgAge: number }> = {};
+    for (const strat of STRATS) {
