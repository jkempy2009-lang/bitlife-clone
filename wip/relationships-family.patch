+      stats[strat].avgAge = Math.round(stats[strat].avgAge / stats[strat].lives);
+    }
+    fs.writeFileSync(OUT, JSON.stringify({ stats, issues }, null, 2) + "\n\n" + log.join("\n"));
+  });
+});
