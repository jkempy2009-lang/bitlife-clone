+      }
+      if (n.kind === "info" && /divorce|breakup|affair|baby|pregnan|passed away|Caught|Strain|Teenage|grown|drift/i.test(n.title + n.body)) log.push(`[${tag} age ${p.age}] ${n.title}: ${n.body.slice(0, 200)}`);
+    }
+    void logStart; void before;
+    invariants(p, tag);
+    children = p.stats.childrenBorn;
+  }
+  log.push(`[${tag}] END age ${p.age} children ${children} cause ${p.causeOfDeath}`);
+  return p;
+}
+
+function chooseOption(p: PlayerState, ev: { options: unknown[]; id: string }, rng: Rng, strat: Strategy): number {
+  void strat; void p;
+  return rng.int(0, ev.options.length - 1);
+}
+
+function act(p: PlayerState, rng: Rng, strat: Strategy, log: string[]): PlayerState {
