+type Strategy = "mono" | "serial" | "poly" | "single" | "parent" | "divorcee" | "phobe";
+const STRATS: Strategy[] = ["mono", "serial", "poly", "single", "parent", "divorcee", "phobe"];
+
+const issues: Record<string, { count: number; sample: string }> = {};
+const flag = (k: string, sample: string) => {
+  const e = issues[k] ?? (issues[k] = { count: 0, sample });
+  e.count++;
+};
+
+function settle(p: PlayerState, res: { player: PlayerState }): PlayerState {
+  if (res.player !== p) finalize(res.player, []);
+  return res.player;
+}
+
+function invariants(p: PlayerState, tag: string) {
+  const partners = p.relatives.filter((r) => r.relation === "Partner" && r.alive && r.partnerStatus !== "ex");
+  if (partners.length > 1) flag("multiple active partners", `${tag} age ${p.age}: ${partners.map((x) => x.name + x.partnerStatus).join(",")}`);
+  for (const r of p.relatives) {
+    if (typeof r.age !== "number" || Number.isNaN(r.age)) flag("relative without age", `${tag} ${r.name} ${r.relation}`);
+    if ((r.relation === "Partner" || r.relation === "Lover") && r.alive && r.partnerStatus !== "ex" && r.age < 18 && p.age >= 18) flag("minor partner of adult", `${tag} p.age ${p.age} ${r.name} ${r.age}`);
+    if ((r.relation === "Partner" || r.relation === "Lover") && r.alive && r.partnerStatus !== "ex" && r.age < 18 && p.age < 16) flag("partner for under 16", `${tag}`);
+    if (r.relation === "Partner" && r.partnerStatus === "married" && !r.marriedYear) flag("married without marriedYear", `${tag} ${r.name}`);
+    if (r.relationshipBar < 0 || r.relationshipBar > 100) flag("bar out of range", `${tag}`);
+    if (r.relation === "Child" && r.alive && r.age < 0) flag("child neg age", tag);
+    if (r.relation === "Partner" && !r.alive && r.partnerStatus !== "ex" && r.partnerStatus === "married") { /* widow */ }
+  }
+  if (p.pregnancy && p.pregnancy.carrier !== "self" && !p.relatives.some((r) => r.id === p.pregnancy!.carrier)) flag("pregnancy carrier missing", tag);
+  if (p.flags.includes("child_support") && !p.relatives.some((r) => r.relation === "Child" && r.alive && r.age < 18)) { /* cleaned in processing */ }
+  const names = p.relatives.filter((r) => r.alive && r.relation !== "Pet").map((r) => r.name);
+  const dupes = names.filter((n, i) => names.indexOf(n) !== i);
+  if (dupes.length) flag("duplicate names among living relatives", `${tag}: ${dupes[0]}`);
+}
+
+function playLife(seed: number, strat: Strategy, log: string[]): PlayerState {
+  const rng = makeRng(seed);
+  let p = createNewPlayer({ scenario: "average", startYear: 2026, talents: NEUTRAL }, rng);
+  p.matureContent = true;
+  const tag = `${strat}#${seed}`;
+  let children = 0;
+  for (let guard = 0; guard < 110 && p.alive; guard++) {
+    if (p.pendingTrial) p = settle(p, resolveTrial(p, "public", rng));
+    p = act(p, rng, strat, log);
+    const before = p.relatives.filter((r) => r.relation === "Partner" && r.alive && r.partnerStatus !== "ex").map((r) => r.name);
+    const logStart = p.lifeLog.length;
+    const res = ageUp(p, rng);
+    p = res.player;
