+      if (p.age >= 18) p = settle(p, seduce(p, rng.pick(SEDUCE_TARGETS).id, rng.chance(0.6), rng));
+      break;
+    }
+    case "poly": {
+      if (p.age >= 18 && !pa && rng.chance(0.5)) p = take(meetSomeone(p, "date", rng) as never);
+      if (pa && p.age >= 18) {
+        p = settle(p, proposeOpenRelationship(p, rng, "poly"));
+        if (p.age >= 18) p = settle(p, hookUp(p, "scene" as never, true, rng, "relationship"));
+        p = settle(p, hookUp(p, rng.pick(["bar", "app", "singles"] as const), true, rng, "casual"));
