@@ -0,0 +1,69 @@
+import { it } from "vitest";
+import { makeRng } from "@/lib/rng";
+import { ageUp } from "../ageUp";
+import { createNewPlayer } from "../state";
+import { resolveEvent } from "../events";
+import { setHabit } from "../health";
+import { visitDoctor } from "../activities";
+import type { Notice, PlayerState } from "@/types/game.types";
+import { resolveTrial } from "../crime";
+import fs from "node:fs";
+
+const OUT = "/tmp/claude-0/-home-user-bitlife-clone/9286e593-ea74-5b82-bd58-1dff269f48ec/scratchpad/";
+type Strat = "random" | "healthy" | "party" | "doctor";
+function life(seed: number, country: string, startYear: number, strat: Strat) {
+  const rng = makeRng(seed);
+  let p: PlayerState = createNewPlayer({ scenario: "average", startYear, country }, rng);
+  const evCount: Record<string, number> = {};
+  for (let g = 0; g < 150 && p.alive; g++) {
+    if (p.pendingTrial) p = resolveTrial(p, "public", rng).player;
+    if (p.pendingTrial) break;
+    const res = ageUp(p, rng);
+    p = res.player;
+    for (const n of (res.notices ?? []) as Notice[]) {
+      if (n.kind === "event" && p.alive) {
+        evCount[n.event.id] = (evCount[n.event.id] ?? 0) + 1;
+        p = resolveEvent(p, n.event, rng.int(0, n.event.options.length - 1), rng).player;
+      }
+    }
+    if (strat === "healthy" && p.age >= 14) {
+      p = setHabit(setHabit(p, "exercise", 2).player, "diet", 2).player;
+    }
+    if (strat === "party" && p.age >= 16) {
+      p.vices.alcohol = Math.max(p.vices.alcohol, 40);
+      p.vices.smoking = Math.max(p.vices.smoking, 30);
+    }
+    if (strat === "doctor" && p.age >= 30) {
+      p = visitDoctor(p, null, rng).player;
+      for (const d of p.diseases) p = visitDoctor(p, d.id, rng).player;
+    }
+  }
+  return { p, evCount };
+}
+
+it("mortality survey", () => {
+  const out: string[] = [];
+  const countries = ["United States", "India", "Nigeria", "Japan"];
+  for (const strat of ["random", "party"] as Strat[]) {
+    for (const c of countries) {
+      const N = 40;
+      const ages: number[] = [];
+      const causes: Record<string, number> = {};
+      let under5 = 0, under18 = 0, under40 = 0, over90 = 0;
+      for (let s = 1; s <= N; s++) {
+        const { p } = life(s * 31 + 7, c, 2026, strat);
+        ages.push(p.age);
+        if (p.age < 5) under5++;
+        if (p.age < 18) under18++;
+        if (p.age < 40) under40++;
+        if (p.age >= 90) over90++;
+        const k = p.causeOfDeath ?? "?";
+        causes[k] = (causes[k] ?? 0) + 1;
+      }
+      ages.sort((a, b) => a - b);
+      const top = Object.entries(causes).sort((a, b) => b[1] - a[1]).slice(0, 6).map(([k, v]) => `${k}:${v}`).join("; ");
+      out.push(`${strat.padEnd(7)} ${c.padEnd(15)} median ${ages[N >> 1]} mean ${(ages.reduce((a, b) => a + b, 0) / N).toFixed(1)} <5:${under5} <18:${under18} <40:${under40} 90+:${over90} | ${top}`);
+    }
+  }
+  fs.writeFileSync(OUT + "mortality.txt", out.join("\n"));
+});
