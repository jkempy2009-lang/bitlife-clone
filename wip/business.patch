+import { NEUTRAL } from "./helpers/neutral";
+import { it } from "vitest";
+import { makeRng, type Rng } from "@/lib/rng";
+import { createNewPlayer, netWorth } from "../state";
+import { ageUp, finalize } from "../ageUp";
+import { resolveEvent } from "../events";
+import { startBusiness, hireStaff, runMarketing, recommendedStaff } from "../paths";
+import type { Notice, PlayerState } from "@/types/game.types";
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+function act(p: PlayerState, rng: Rng, fn: (p: PlayerState, r: Rng) => any): PlayerState {
+  const res = fn(p, rng);
+  if (res.player !== p) finalize(res.player, []);
+  return res.player;
+}
+
+function life(seed: number, kind: string, franchise: boolean) {
+  const rng = makeRng(seed);
+  let p = createNewPlayer({ scenario: "average", startYear: 2026, talents: NEUTRAL }, rng);
+  p.age = 28; p.birthYear = p.year - 28;
+  p.education = { stage: "None", yearsLeft: 0, major: null, grades: 60, studyEffort: 0, degrees: ["highschool"] };
+  p.smarts = 70; p.health = 90; p.bankBalance = 1_000_000; p.economy = { climate: "normal", yearsLeft: 3 };
+  p = act(p, rng, (pl, r) => startBusiness(pl, kind, "T", r, { franchise }));
+  if (!p.business) throw new Error("no biz");
+  const start = netWorth(p);
+  let profits = 0, yrs = 0, bankrupt = false;
+  for (let y = 0; y < 10; y++) {
+    let g = 0;
+    while (p.business && p.business.staff < recommendedStaff(p, p.business) && g++ < 20) { const q = act(p, rng, (pl) => hireStaff(pl)); if (q === p) break; p = q; }
+    p = act(p, rng, (pl) => runMarketing(pl));
+    const res = ageUp(p, rng);
+    p = res.player;
+    for (const n of (res.notices ?? []) as Notice[]) if (n.kind === "event" && p.alive) { const nn = n; p = act(p, rng, (pl, r) => resolveEvent(pl, nn.event, r.int(0, nn.event.options.length - 1), r)); }
+    p = { ...p, pendingTrial: null };
+    if (!p.business) { bankrupt = p.flags.some((f) => f.startsWith("biz_cooloff")); break; }
+    profits += p.business.lastProfit; yrs++;
+  }
+  return { bankrupt, avgProfit: yrs ? profits / yrs : 0, gain: netWorth(p) - start };
+}
+
+it("franchise vs independent", () => {
+  const out: string[] = [];
+  for (const kind of ["foodtruck", "boutique", "barcafe", "restaurant", "gym"]) {
+    for (const fr of [false, true]) {
+      const rs = [];
+      for (let s = 1; s <= 120; s++) rs.push(life(s * 13 + 5, kind, fr));
+      const bk = rs.filter((r) => r.bankrupt).length;
+      const mean = (a: number[]) => a.reduce((x, y) => x + y, 0) / a.length;
+      const g = rs.map((r) => r.gain).sort((a, b) => a - b);
+      out.push(`${kind.padEnd(10)} ${fr ? "FRANCH" : "indep "} bankrupt ${bk}/120 avgProfit ${Math.round(mean(rs.map((r) => r.avgProfit)) / 1000)}k  gain p10 ${Math.round(g[12] / 1000)}k med ${Math.round(g[60] / 1000)}k p90 ${Math.round(g[108] / 1000)}k`);
+    }
+  }
+  console.log(out.join("\n"));
+});
