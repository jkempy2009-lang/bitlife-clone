+import { NEUTRAL } from "./helpers/neutral";
+import { it } from "vitest";
+import { makeRng } from "@/lib/rng";
+import { createNewPlayer } from "../state";
+import { BUSINESS_TYPES, recommendedStaff } from "../paths";
+import { newBusiness, stepYear, NO_SHOCKS, capacityOf } from "../businessModel";
+
+it("econ table", () => {
+  const rng = makeRng(1);
+  const p = createNewPlayer({ scenario: "average", startYear: 2026, talents: NEUTRAL }, rng);
+  p.smarts = 70; p.age = 35; p.effort = "steady";
+  p.economy = { climate: "normal", yearsLeft: 3 };
+  const lines: string[] = [];
+  for (const k of BUSINESS_TYPES) {
+    const row: string[] = [k.id.padEnd(13)];
+    for (const mode of ["L1-owner", "L2-owner", "L3-owner", "L2-mgr", "L3-mgr","L4-mgr"]) {
+      const b = newBusiness(k, "x", 2026, makeRng(2));
+      b.fit = 1; b.customers = 55; b.reputation = 55; b.quality = 55; b.marketing = 1.2; b.facility = 75; b.morale = 65; b.training = 40;
+      const pp = { ...p, effort: "steady" as const }; b.locations = Math.min(k.maxLocations, Number(mode[1]));
+      if (mode.endsWith("mgr")) b.manager = { name: "m", skill: 65, wage: Math.round(k.mgrWage*1.25), hired: 2026 };
+      
+      let best = -1e12, bs = 0;
+      for (let n = 0; n <= k.maxStaff*b.locations; n++) { const s = stepYear(pp, { ...b, staff: n }, NO_SHOCKS); if (s.pnl.operating > best) { best = s.pnl.operating; bs = n; } }
+      const s = stepYear(pp, { ...b, staff: bs }, NO_SHOCKS);
+      row.push(`${mode}: op ${Math.round(best / 1000)}k rev ${Math.round(s.pnl.revenue / 1000)}k staff ${bs} cap ${capacityOf(pp, { ...b, staff: bs }).toFixed(2)}`);
+    }
+    lines.push(row.join(" | "));
+    lines.push(`   cost ${k.cost} recommended ${recommendedStaff(p, newBusiness(k, "x", 2026, makeRng(2)))}`);
+  }
+  console.log(lines.join("\n"));
+});
