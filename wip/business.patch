@@ -0,0 +1,99 @@
+import { NEUTRAL } from "./helpers/neutral";
+import { it } from "vitest";
+import fs from "node:fs";
+import { makeRng, type Rng } from "@/lib/rng";
+import { createNewPlayer, netWorth } from "../state";
+import { ageUp, finalize } from "../ageUp";
+import { resolveEvent } from "../events";
+import {
+  BUSINESS_TYPES, startBusiness, hireStaff, hireManager, expandBusiness, takeBusinessLoan, loanLimit, sellBusiness, runMarketing,
+  recommendedStaff, setPayout, renovateBusiness,
+} from "../paths";
+import type { Notice, PlayerState } from "@/types/game.types";
+
+const OUT = "/tmp/claude-0/-home-user-bitlife-clone/9286e593-ea74-5b82-bd58-1dff269f48ec/scratchpad/bot.json";
+
+type Strat = "bootstrap" | "leveraged" | "manager" | "serial" | "struggle" | "seller" | "default";
+function adult(seed: number, cash: number) {
+  const rng = makeRng(seed);
+  const p = createNewPlayer({ scenario: "average", startYear: 2026, talents: NEUTRAL }, rng);
+  p.age = 28; p.birthYear = p.year - 28;
+  p.education = { stage: "None", yearsLeft: 0, major: null, grades: 60, studyEffort: 0, degrees: ["highschool"] };
+  p.smarts = 70; p.health = 90;
+  p.skills.charisma = 40; p.skills.athletics = 40;
+  p.bankBalance = cash; p.economy = { climate: "normal", yearsLeft: 3 };
+  return { rng, p };
+}
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+function act(p: PlayerState, rng: Rng, fn: (p: PlayerState, r: Rng) => any): PlayerState {
+  const res = fn(p, rng);
+  if (res.player !== p) finalize(res.player, []);
+  return res.player;
+}
+function pick(rng: Rng, cash: number) {
+  const afford = BUSINESS_TYPES.filter(k => k.cost <= cash * 0.9 && k.minSmarts <= 70 && (!k.skill || k.skill.min <= 40));
+  if (!afford.length) return null;
+  return rng.pick(afford);
+}
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+function playLife(seed: number, strat: Strat, cash: number): any {
+  const { rng, p: p0 } = adult(seed, cash);
+  let p = p0;
+  const kind = pick(rng, cash);
+  if (!kind) return null;
+  p = act(p, rng, (pl, r) => startBusiness(pl, kind.id, "Bot Co", r));
+  if (!p.business) return null;
+  const startNW = netWorth(p);
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  const rec: any = { seed, strat, kind: kind.id, cash, years: 0, outcome: "alive", draws: [] as number[], logs: [] as string[], peakValue: 0 };
+  let businesses = 1;
+  for (let y = 0; y < 25 && p.alive; y++) {
+    const before = p.bankBalance;
+    if (p.business) {
+      const b = p.business;
+      const lim = () => loanLimit(p, p.business!);
+      const staffTarget = () => recommendedStaff(p, p.business!);
+      const manageStaff = () => { let g = 0; while (p.business && p.business.staff < staffTarget() && g++ < 20) { const q = act(p, rng, (pl) => hireStaff(pl)); if (q === p) break; p = q; } };
+      if (strat === "bootstrap") { manageStaff(); p = act(p, rng, (pl) => runMarketing(pl)); if (p.business && p.business.cash > 150_000 && p.business.facility < 70) p = act(p, rng, (pl)=>renovateBusiness(pl)); }
+      if (strat === "leveraged") {
+        manageStaff(); p = act(p, rng, (pl) => runMarketing(pl));
+        if (p.business && lim() > 20000) { p = act(p, rng, (pl) => takeBusinessLoan(pl, lim())); }
+        if (p.business && p.business.history.length >= 1 && p.business.lastProfit > 0) p = act(p, rng, (pl) => expandBusiness(pl));
+        if (p.business) p = act(p, rng, (pl) => setPayout(pl, "reinvest"));
+      }
+      if (strat === "manager") {
+        if (!b.manager && y >= 1) p = act(p, rng, (pl, r) => hireManager(pl, r, "star"));
+        manageStaff(); p = act(p, rng, (pl) => runMarketing(pl)); p = { ...p, effort: "coast" };
+      }
+      if (strat === "serial") { manageStaff(); p = act(p, rng, (pl) => runMarketing(pl)); if (y >= 4 && p.business) { p = act(p, rng, (pl, r) => sellBusiness(pl, r)); businesses++; if (!p.business) { const k2 = pick(rng, p.bankBalance); if (k2) p = act(p, rng, (pl, r) => startBusiness(pl, k2.id, "Next Co", r)); } } }
+      if (strat === "struggle") { p = { ...p, effort: "coast" }; if (b.staff < 1) p = act(p, rng, (pl) => hireStaff(pl)); }
+      if (strat === "seller") { manageStaff(); p = act(p, rng, (pl) => runMarketing(pl)); if (y === 6) { p = act(p, rng, (pl, r) => sellBusiness(pl, r)); } }
+      if (strat === "default") { manageStaff(); }
+    }
+    const res = ageUp(p, rng);
+    p = res.player;
+    for (const n of (res.notices ?? []) as Notice[]) {
+      if (n.kind === "event" && p.alive) { const nn = n; p = act(p, rng, (pl, r) => resolveEvent(pl, nn.event, r.int(0, nn.event.options.length - 1), r)); }
+    }
+    rec.draws.push(p.bankBalance - before);
+    rec.years = y + 1;
+    if (p.business) rec.peakValue = Math.max(rec.peakValue, p.business.value);
+    if (!p.business && p.flags.some(f => f.startsWith("biz_cooloff"))) { rec.outcome = "bankrupt@" + (y + 1); break; }
+    if (!p.business && strat !== "serial") { rec.outcome = "exited@" + (y+1); break; }
+  }
+  rec.endNW = netWorth(p); rec.startNW = startNW; rec.businesses = businesses;
+  rec.final = p.business ? { value: p.business.value, rev: p.business.revenue, profit: p.business.lastProfit, cash: p.business.cash, debt: p.business.debt, locs: p.business.locations, staff: p.business.staff, rep: p.business.reputation } : null;
+  return rec;
+}
+
+it("scratch bot", () => {
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  const out: any[] = [];
+  const strats: Strat[] = ["bootstrap", "leveraged", "manager", "serial", "struggle", "seller", "default"];
+  for (const strat of strats) for (let s = 1; s <= 120; s++) {
+    const cash = [60_000, 150_000, 400_000, 1_500_000][s % 4];
+    try { const r = playLife(s * 7919 + strats.indexOf(strat), strat, cash); if (r) out.push(r); } catch (e) { out.push({ strat, seed: s, crash: String((e as Error).stack) }); }
+  }
+  fs.writeFileSync(OUT, JSON.stringify(out));
+});
