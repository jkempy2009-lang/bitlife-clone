+import { NEUTRAL } from "./helpers/neutral";
+import { it } from "vitest";
+import fs from "node:fs";
+import { makeRng, type Rng } from "@/lib/rng";
+import { createNewPlayer } from "../state";
+import { ageUp, finalize } from "../ageUp";
+import { resolveEvent } from "../events";
+import { startBusiness, hireStaff, recommendedStaff, runMarketing } from "../paths";
+import type { Notice, PlayerState } from "@/types/game.types";
+
+const OUT = "/tmp/claude-0/-home-user-bitlife-clone/9286e593-ea74-5b82-bd58-1dff269f48ec/scratchpad/story.txt";
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+function act(p: PlayerState, rng: Rng, fn: (p: PlayerState, r: Rng) => any): PlayerState {
+  const res = fn(p, rng);
+  if (res.player !== p) finalize(res.player, []);
+  return res.player;
+}
+it("story", () => {
+  const lines: string[] = [];
+  const evCount: Record<string, number> = {};
+  const noticeTitles: Record<string, number> = {};
+  let lives = 0;
+  for (const kindId of ["restaurant", "gym", "onlinestore", "construction"]) {
+    for (let s = 1; s <= 60; s++) {
+      const rng = makeRng(s * 31 + kindId.length);
+      let p = createNewPlayer({ scenario: "average", startYear: 2026, talents: NEUTRAL }, rng);
+      p.age = 28; p.birthYear = p.year - 28;
+      p.education = { stage: "None", yearsLeft: 0, major: null, grades: 60, studyEffort: 0, degrees: ["highschool"] };
+      p.smarts = 70; p.health = 90; p.bankBalance = 1_500_000; p.economy = { climate: "normal", yearsLeft: 3 };
+      p = act(p, rng, (pl, r) => startBusiness(pl, kindId, "Story Co", r));
+      lives++;
+      const verbose = s === 3;
+      for (let y = 0; y < 15 && p.alive && p.business; y++) {
+        let g = 0;
+        while (p.business && p.business.staff < recommendedStaff(p, p.business) && g++ < 20) { const q = act(p, rng, (pl) => hireStaff(pl)); if (q === p) break; p = q; }
+        p = act(p, rng, (pl) => runMarketing(pl));
+        const res = ageUp(p, rng);
+        p = res.player;
+        for (const n of (res.notices ?? []) as Notice[]) {
+          if (n.kind === "event") {
+            evCount[n.event.id] = (evCount[n.event.id] ?? 0) + 1;
+            if (n.event.id.startsWith("biz_") && verbose) lines.push(`  [event ${p.year}] ${n.event.id}`);
+            if (p.alive) { const nn = n; p = act(p, rng, (pl, r) => resolveEvent(pl, nn.event, r.int(0, nn.event.options.length - 1), r)); }
+          } else if (n.kind === "info") {
+            noticeTitles[n.title] = (noticeTitles[n.title] ?? 0) + 1;
+            if (verbose && /Business|Market|Cash|Overdraft|Covenant|Loan|Manager|Incident|Franchise|Black|Bankrupt|Crunch/.test(n.title)) lines.push(`  [${p.year}] ${n.title}: ${n.body}`);
+          }
+        }
+        if (verbose && p.business) lines.push(`${p.year} biz rev=${p.business.revenue} profit=${p.business.lastProfit} cash=${Math.round(p.business.cash)} rep=${Math.round(p.business.reputation)} cust=${Math.round(p.business.customers)} comp=${Math.round(p.business.competition)} morale=${Math.round(p.business.morale)} staff=${p.business.staff}`);
+      }
+      if (verbose) lines.push(`--- end ${kindId} alive=${p.alive} biz=${!!p.business}`);
+    }
+  }
+  lines.push("EVENTS PER LIFE: " + JSON.stringify(Object.fromEntries(Object.entries(evCount).filter(([k]) => k.startsWith("biz_")).map(([k, v]) => [k, +(v / lives).toFixed(2)]))));
+  lines.push("NON-BIZ events while owning (top): " + JSON.stringify(Object.entries(evCount).filter(([k]) => !k.startsWith("biz_")).sort((a, b) => b[1] - a[1]).slice(0, 15)));
+  lines.push("NOTICES: " + JSON.stringify(noticeTitles));
+  fs.writeFileSync(OUT, lines.join("\n"));
+});
