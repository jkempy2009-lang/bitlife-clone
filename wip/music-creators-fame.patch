+import { NEUTRAL } from "./helpers/neutral";
+import { describe, it } from "vitest";
+import { makeRng, type Rng } from "@/lib/rng";
+import { ageUp } from "../ageUp";
+import { createNewPlayer } from "../state";
+import { resolveEvent } from "../events";
+import { resolveTrial } from "../crime";
+import { applyForJob, quitJob } from "../career";
+import * as inf from "../influencer";
+import * as mu from "../music";
+import { resolveScandal } from "../celebrity";
+import type { ActionResult, Notice, PlayerState } from "@/types/game.types";
+import { appendFileSync, writeFileSync } from "node:fs";
+
+const OUT = process.env.PLAY_OUT ?? "/tmp/play.txt";
+export const DEATHS: Record<string, Record<string, number>> = {};
+export const EVC: Record<string, Record<string, number>> = {};
+const logLine = (s: string) => appendFileSync(OUT, s + "\n");
+
+type Strategy = (p: PlayerState, rng: Rng) => PlayerState;
+const ap = (p: PlayerState, r: ActionResult) => r.player ?? p;
+
+function life(seed: number, name: string, strat: Strategy, trace: boolean, stopAge = 999) {
+  const rng = makeRng(seed);
+  const tal = { ...NEUTRAL, musical: Number(process.env.MUSICAL ?? 50) };
+  let p = createNewPlayer({ scenario: "average", startYear: 2026, talents: tal }, rng);
+  const rows: string[] = [];
+  const stats = { peakFans: 0, peakFollowers: 0, peakFame: 0, albums: 0, hits: 0, signedYears: 0, scandals: 0, died: p.age, endNet: 0, maxBank: 0, minBank: 1e12, music$: 0, inf$: 0 };
+  for (let guard = 0; guard < 120 && p.alive && p.age < stopAge; guard++) {
+    const res = ageUp(p, rng);
+    p = res.player;
+    const notices = (res.notices ?? []) as Notice[];
+    for (const n of notices) {
+      if (n.kind === "event" && p.alive) {
+        // choose first non-money-losing option at random
+        const idx = rng.int(0, n.event.options.length - 1);
+        (EVC[name] ??= {})[n.event.id] = ((EVC[name] ??= {})[n.event.id] ?? 0) + 1;
+        p = resolveEvent(p, n.event, idx, rng).player;
+        if (trace) rows.push(`   EVENT ${n.event.id}:`);
+      } else if (trace && (n.kind === "info") && p.age >= 14) {
+        rows.push(`   [${(n as { title: string }).title}] ${(n as { body: string }).body}`);
+      }
+    }
+    if (!p.alive) break;
+    if (p.pendingTrial) p = resolveTrial(p, "plea", rng).player;
+    if (p.age >= 12) p = strat(p, rng);
+    const m = p.music;
+    const i = p.influencer;
+    stats.peakFans = Math.max(stats.peakFans, m.fans);
+    stats.peakFollowers = Math.max(stats.peakFollowers, i.followers);
+    stats.peakFame = Math.max(stats.peakFame, p.fame);
+    stats.maxBank = Math.max(stats.maxBank, p.bankBalance);
+    if (m.signed) stats.signedYears++;
+    if (trace && p.age >= 12 && (m.status !== "none" || i.active)) {
+      rows.push(
+        `age ${p.age} fame ${Math.round(p.fame)} bank ${Math.round(p.bankBalance)} | music ${m.status}${m.signed ? "*" : ""} fans ${m.fans} lf ${Math.round(m.localFame)} rel ${Math.round(m.relevance)} burn ${Math.round(m.burnout)} skill ${p.skills.music} sw ${m.songwriting} albums ${m.albums.length} inc ${JSON.stringify(m.lastIncome)} unrec ${m.contract?.unrecouped ?? "-"} | inf ${i.active ? `${i.followers} eng ${i.engagement} auth ${i.authenticity} burn ${Math.round(i.burnout)} deals ${i.deals.length} inc ${JSON.stringify(i.income)}` : "-"} | priv ${p.celeb.privacy} stalk ${Math.round(p.celeb.stalker)}`,
+      );
+    }
+  }
+  stats.albums = p.music.albums.length;
+  stats.hits = p.music.hits;
+  stats.scandals = p.celeb.scandals;
+  stats.died = p.age;
+  (DEATHS[name] ??= {})[p.causeOfDeath ?? 'alive'] = ((DEATHS[name] ??= {})[p.causeOfDeath ?? 'alive'] ?? 0) + 1;
+  stats.endNet = Math.round(p.bankBalance);
+  stats.music$ = Math.round(p.music.earnings);
+  stats.inf$ = Math.round(p.influencer.lifetimeEarnings);
+  if (trace) logLine(`==== ${name} seed ${seed}\n` + rows.join("\n"));
+  return { p, stats };
+}
+
+const reply = (p: PlayerState, rng: Rng) => {
+  if (p.celeb.scandal) p = ap(p, resolveScandal(p, rng, "prFirm"));
+  return p;
+};
+
+// ----- strategies -----
+const busker: Strategy = (p, rng) => {
+  if (p.age >= 14 && p.music.status === "none") p = ap(p, mu.startSolo(p));
+  p = ap(p, mu.practiceMusic(p, rng));
+  p = ap(p, mu.writeSongs(p, rng));
+  if (!p.currentJob && p.age >= 18) p = ap(p, applyForJob(p, "retail", rng));
+  p.effort = "coast";
+  return p;
+};
+
+const labelPop: Strategy = (p, rng) => {
+  p = reply(p, rng);
+  if (p.age >= 14 && p.music.status === "none") p = ap(p, mu.startSolo(p));
+  p.effort = "grind";
+  p = ap(p, mu.practiceMusic(p, rng));
+  p = ap(p, mu.writeSongs(p, rng));
+  if (!p.music.signed) {
+    p = ap(p, mu.recordDemo(p, rng));
+    if (!p.music.manager) p = ap(p, mu.toggleManager(p));
+    if (p.age >= 18) p = ap(p, mu.auditionContract(p, "solo", 80, rng));
+    if (p.age >= 16 && !p.currentJob) p = ap(p, mu.recordAlbum(p, "Pop", "", { producer: p.bankBalance > 10_000 ? "local" : "self", direction: "commercial" }));
+  } else {
+    if (p.music.pendingAlbum == null) p = ap(p, mu.recordAlbum(p, "Pop", "", { producer: p.fame >= 30 ? "pro" : "local", direction: "commercial" }));
+    if ((p.annual.album ?? 0) === 0) {
+      const scale = [...mu.TOUR_SCALES].reverse().find((t) => p.music.fans >= t.minFans);
+      if (scale) p = ap(p, mu.goOnTour(p, rng, scale.id));
+    }
+    if (p.music.contract) p = ap(p, mu.renegotiateContract(p, rng));
+    if (p.music.burnout > 75) p = ap(p, mu.takeMusicBreak(p));
+  }
+  return p;
+};
+
+const indieGrinder: Strategy = (p, rng) => {
+  p = reply(p, rng);
+  if (p.age >= 14 && p.music.status === "none") p = ap(p, mu.startSolo(p));
+  if (p.age >= 14 && p.music.status === "solo" && p.skills.music > 25) p = ap(p, mu.formBand(p, 70, rng));
+  p.effort = "steady";
+  p = ap(p, mu.practiceMusic(p, rng));
+  p = ap(p, mu.writeSongs(p, rng));
+  p = ap(p, mu.recruitMember(p, rng));
+  p = ap(p, mu.teamNight(p));
+  if (p.bankBalance > 3000) p = ap(p, mu.recordDemo(p, rng));
+  if (p.age >= 18 && !p.currentJob && !p.music.signed) p = ap(p, applyForJob(p, "retail", rng));
+  if (p.year % 2 === 0 && p.age >= 16 && p.bankBalance > 12_000) p = ap(p, mu.recordAlbum(p, "Rock", "", { producer: "local", direction: "artistic" }));
+  else if (p.year % 2 === 0 && p.age >= 16 && p.bankBalance > 4_000 && !p.music.pendingAlbum) p = ap(p, mu.recordAlbum(p, "Rock", "", { producer: "self", direction: "artistic" }));
+  if (!p.music.signed && !p.music.pendingAlbum) {
+    const sc = [...mu.TOUR_SCALES].reverse().find((t) => p.music.fans >= t.minFans && p.bankBalance > t.fixed);
+    if (!mu.supportBlock(p) && (!sc || sc.id === "club")) p = ap(p, mu.goOnTour(p, rng, "club", { mode: "support" }));
+    else if (sc) p = ap(p, mu.goOnTour(p, rng, sc.id));
+  }
+  return p;
+};
+
+const indieAllIn: Strategy = (p, rng) => {
+  p = reply(p, rng);
+  if (p.age >= 14 && p.music.status === "none") p = ap(p, mu.startSolo(p));
+  if (p.age >= 14 && p.music.status === "solo" && p.skills.music > 25) p = ap(p, mu.formBand(p, 70, rng));
+  p.effort = "grind";
+  p = ap(p, mu.practiceMusic(p, rng));
+  p = ap(p, mu.writeSongs(p, rng));
+  p = ap(p, mu.recruitMember(p, rng));
+  for (const mem of p.music.members) { if (mem.grievance === "habit") p = ap(p, mu.sendToRehab(p, rng, mem.id)); else if (mem.grievance === "credit") p = ap(p, mu.shareCredit(p, mem.id)); else if (mem.grievance === "money") p = ap(p, mu.payRaise(p, mem.id)); else if (mem.grievance) p = ap(p, mu.talkToMember(p, rng, mem.id)); }
+  p = ap(p, mu.teamNight(p));
+  if (p.bankBalance > 3000) p = ap(p, mu.recordDemo(p, rng));
+  if (p.age >= 18 && p.currentJob) p = ap(p, quitJob(p));
+  if (p.age >= 17 && p.year % 2 === 0 && p.bankBalance > 4_000) p = ap(p, mu.recordAlbum(p, "Rock", "", { producer: p.bankBalance > 15_000 ? "local" : "self", direction: "balanced" }));
+  if (!p.music.signed && !p.music.pendingAlbum && p.age >= 17) {
+    const sc = [...mu.TOUR_SCALES].reverse().find((t) => p.music.fans >= t.minFans && p.bankBalance > t.fixed);
+    if (!mu.supportBlock(p) && (!sc || sc.id === "club")) p = ap(p, mu.goOnTour(p, rng, "club", { mode: "support" }));
+    else if (sc) p = ap(p, mu.goOnTour(p, rng, sc.id));
+  }
+  if (p.age >= 20 && !p.music.signed) p = ap(p, mu.auditionContract(p, p.music.status === "band" ? "band" : "solo", 80, rng));
+  if (p.music.signed) {
+    p = ap(p, mu.recordAlbum(p, "Rock", "", { producer: p.fame >= 30 ? "pro" : "local", direction: "balanced" }));
+    const scale = [...mu.TOUR_SCALES].reverse().find((t) => p.music.fans >= t.minFans);
+    if (scale && !p.music.pendingAlbum) p = ap(p, mu.goOnTour(p, rng, scale.id));
+  }
+  if (p.music.burnout > 80) p = ap(p, mu.takeMusicBreak(p));
+  return p;
+};
+
+const viralCreator: Strategy = (p, rng) => {
+  p = reply(p, rng);
+  if (p.age >= 13 && !p.influencer.active) p = ap(p, inf.startChannel(p, rng, { platform: "shorts", niche: "comedy" }));
+  if (!p.influencer.active) return p;
+  p.effort = "grind";
+  p = ap(p, inf.postContent(p, rng));
+  if (p.influencer.followers > 20_000 && p.age >= 16 && !p.influencer.fullTime) p = ap(p, inf.goFullTimeCreator(p, true));
+  for (const o of [...p.influencer.offers]) p = ap(p, inf.acceptDeal(p, o.id));
+  if (p.influencer.followers >= 10_000 && !p.influencer.premium) p = ap(p, inf.toggleMemberships(p));
+  if (p.influencer.followers >= 20_000 && !p.influencer.merch) p = ap(p, inf.launchMerch(p));
+  if (p.influencer.burnout > 80) p = ap(p, inf.takeBreak(p));
+  if (p.influencer.bannedYears > 0) p = ap(p, inf.appealBan(p, rng));
+  return p;
+};
+
+const brandChaser: Strategy = (p, rng) => {
+  p = reply(p, rng);
+  if (p.age >= 14 && !p.influencer.active) p = ap(p, inf.startChannel(p, rng, { platform: "photo", niche: "beauty" }));
+  if (!p.influencer.active) return p;
+  p.effort = "steady";
+  p = ap(p, inf.postContent(p, rng));
+  p = ap(p, inf.brandCollab(p));
+  p = ap(p, inf.buyFollowers(p, rng));
+  for (const o of [...p.influencer.offers].sort((a, b) => b.pay - a.pay)) p = ap(p, inf.acceptDeal(p, o.id));
+  if (p.influencer.burnout > 85) p = ap(p, inf.takeBreak(p));
+  if (p.influencer.bannedYears > 0) p = ap(p, inf.appealBan(p, rng));
+  return p;
+};
+
+const burnout: Strategy = (p, rng) => {
+  p = reply(p, rng);
+  if (p.age >= 16 && p.music.status === "none") p = ap(p, mu.startSolo(p));
+  p.effort = "grind";
+  p = ap(p, mu.practiceMusic(p, rng));
+  p = ap(p, mu.writeSongs(p, rng));
+  if (!p.music.signed && p.age >= 18) {
+    p = ap(p, mu.recordDemo(p, rng));
+    p = ap(p, mu.auditionContract(p, "solo", 100, rng));
+  }
+  if (p.music.signed) {
+    p = ap(p, mu.recordAlbum(p, "Rock", "", { producer: "pro", direction: "balanced" }));
+    const scale = [...mu.TOUR_SCALES].reverse().find((t) => p.music.fans >= t.minFans);
+    if (scale) p = ap(p, mu.goOnTour(p, rng, scale.id));
+  }
+  return p;
+};
+
+const fameAverse: Strategy = (p, rng) => {
+  p = reply(p, rng);
+  if (p.age >= 14 && p.music.status === "none") p = ap(p, mu.startSolo(p));
+  p.effort = "coast";
+  p = ap(p, mu.practiceMusic(p, rng));
+  if (p.age >= 18 && !p.currentJob) p = ap(p, applyForJob(p, "retail", rng));
+  if (p.bankBalance > 10_000 && !p.music.pendingAlbum) p = ap(p, mu.recordAlbum(p, "Jazz", "", { producer: "local", direction: "artistic" }));
+  return p;
+};
+
+const STRATS: Record<string, Strategy> = { indieAllIn, busker, labelPop, indieGrinder, viralCreator, brandChaser, burnout, fameAverse };
+
+describe("dump", () => {
+  it("dumps saves", () => {
+    const jobs: Array<[string, Strategy, number, number]> = [["band", indieGrinder, 24, 11], ["star", labelPop, 32, 12], ["creator", viralCreator, 26, 13]];
+    for (const [n, st, age, seed] of jobs) {
+      const { p } = life(seed * 101 + 7, n, st, false, age);
+      writeFileSync(`/home/user/bitlife-clone/.claude/worktrees/agent-a78964066f7d374af/scratch/save_${n}.json`, JSON.stringify({ v: 1, player: p, rngState: 12345 }));
+    }
+  });
+});
+
+describe("play", () => {
+  it("plays", () => {
+    writeFileSync(OUT, "");
+    const N = Number(process.env.PLAY_N ?? 60);
+    for (const [name, strat] of Object.entries(STRATS)) {
+      const agg = { n: 0, peakFans: [] as number[], peakFollowers: [] as number[], fame: [] as number[], albums: [] as number[], music$: [] as number[], inf$: [] as number[], endNet: [] as number[], scandals: 0, signed: 0, died: [] as number[] };
+      for (let s = 1; s <= N; s++) {
+        const { stats } = life(s * 101 + 7, name, strat, s <= 2);
+        agg.n++;
+        agg.peakFans.push(stats.peakFans);
+        agg.peakFollowers.push(stats.peakFollowers);
+        agg.fame.push(stats.peakFame);
+        agg.albums.push(stats.albums);
+        agg.music$.push(stats.music$);
+        agg.inf$.push(stats.inf$);
+        agg.endNet.push(stats.endNet);
+        agg.scandals += stats.scandals;
+        if (stats.signedYears > 0) agg.signed++;
+        agg.died.push(stats.died);
+      }
+      const q = (a: number[], f: number) => [...a].sort((x, y) => x - y)[Math.min(a.length - 1, Math.floor(a.length * f))];
+      const row = (label: string, a: number[]) => `${label}: p10 ${Math.round(q(a, 0.1))} p50 ${Math.round(q(a, 0.5))} p90 ${Math.round(q(a, 0.9))} max ${Math.round(q(a, 0.999))}`;
+      logLine(`  events: ` + Object.entries(EVC[name] ?? {}).filter(([k]) => /^(cr_|band|influ|fest|reality|holly|label|paparaz|stalk|fan|music|mx_|form_|rock|talent|record|concert|karaoke|busking|viral)/.test(k)).sort((a, b) => b[1] - a[1]).map(([k, v]) => `${k}:${(v / agg.n).toFixed(2)}`).join(" "));
+      logLine(`  deaths: ` + Object.entries(DEATHS[name] ?? {}).sort((a, b) => b[1] - a[1]).slice(0, 8).map(([k, v]) => `${k}:${v}`).join(" | "));
+      logLine(`#### ${name} (n=${agg.n}) signed ${agg.signed} scandals/life ${(agg.scandals / agg.n).toFixed(1)}\n  ${row("peakFans", agg.peakFans)}\n  ${row("peakFollowers", agg.peakFollowers)}\n  ${row("peakFame", agg.fame)}\n  ${row("albums", agg.albums)}\n  ${row("music$", agg.music$)}\n  ${row("inf$", agg.inf$)}\n  ${row("endBank", agg.endNet)}\n  ${row("deathAge", agg.died)}`);
+    }
+  });
+});
